# ==============================================================================
# PAYFLOW AI — Intelligent Invoice & Payment Agent
# Environment Configuration
# ==============================================================================

# Database Configuration (Default: SQLite local database)
DATABASE_URL=sqlite:///./payflow.db

# Authentication & JWT Security
SECRET_KEY=payflow-ai-production-super-secret-key-32chars!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Provider Configuration (Google Gemini)
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=

# PayPal REST API Configuration (Sandbox / Production)
# Obtain your credentials from: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Service URLs & CORS
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
DEMO_MODE=True

# Configurable Subscription Entitlements (Monthly Invoices & Seats)
LIMIT_FREE_INVOICES=10
LIMIT_FREE_SEATS=1
LIMIT_STARTER_INVOICES=60
LIMIT_STARTER_SEATS=2
LIMIT_PRO_INVOICES=300
LIMIT_PRO_SEATS=5
LIMIT_BUSINESS_INVOICES=999999
LIMIT_BUSINESS_SEATS=999
